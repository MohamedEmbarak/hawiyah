{
  "name": "@hawiyah/core",
  "version": "0.2.0",
  "private": true,
  "description": "Framework-independent behavior and Arabic/English internationalization for Hawiyah, a DGA Platforms Code UI library",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "API.md",
    "third-party",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "keywords": [
    "hawiyah",
    "dga",
    "sdga",
    "platforms-code",
    "saudi-design-system",
    "arabic",
    "rtl",
    "ui-components",
    "core"
  ],
  "dependencies": {
    "@internationalized/date": "3.12.4"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedEmbarak/hawiyah.git",
    "directory": "packages/core"
  },
  "homepage": "https://mohamedembarak.github.io/hawiyah/",
  "bugs": {
    "url": "https://github.com/MohamedEmbarak/hawiyah/issues"
  },
  "author": {
    "name": "Development Team, National Platforms Sector — National Information Center"
  },
  "contributors": [
    {
      "name": "Mohamed Embarak",
      "url": "https://github.com/MohamedEmbarak"
    }
  ]
