{
  "name": "@hawiyah/vanilla",
  "version": "0.2.0",
  "private": true,
  "description": "JavaScript controllers for Hawiyah, a UI library built to comply with the DGA Platforms Code",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "PORTAL.md",
    "EXPANSION-API.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@hawiyah/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "keywords": [
    "hawiyah",
    "dga",
    "sdga",
    "platforms-code",
    "saudi-design-system",
    "arabic",
    "rtl",
    "ui-components",
    "vanilla"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedEmbarak/hawiyah.git",
    "directory": "packages/vanilla"
  },
  "homepage": "https://mohamedembarak.github.io/hawiyah/",
  "bugs": {
    "url": "https://github.com/MohamedEmbarak/hawiyah/issues"
  },
  "author": {
    "name": "Development Team, National Platforms Sector — National Information Center"
  },
  "contributors": [
    {
      "name": "Mohamed Embarak",
      "url": "https://github.com/MohamedEmbarak"
    }
  ]
}
