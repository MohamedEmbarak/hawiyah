{
  "name": "@hawiyah/angular",
  "version": "0.2.0",
  "private": true,
  "description": "Angular components for Hawiyah, a UI library built to comply with the DGA Platforms Code",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "rxjs": "^7.8.0"
  },
  "dependencies": {
    "@hawiyah/core": "workspace:*",
    "tslib": "^2.8.1"
  },
  "exports": {
    ".": {
      "types": "./dist/types/hawiyah-angular.d.ts",
      "default": "./dist/fesm2022/hawiyah-angular.mjs"
    }
  },
  "files": [
    "dist",
    "fesm2022",
    "types",
    "README.md",
    "PORTAL.md",
    "LICENSE",
    "NOTICE"
