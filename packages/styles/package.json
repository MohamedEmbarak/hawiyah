{
  "name": "@hawiyah/styles",
  "version": "0.2.1",
  "private": true,
  "description": "Component styles for Hawiyah, a UI library built to comply with the DGA Platforms Code",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": "./dist/styles.css",
    "./styles.css": "./dist/styles.css",
    "./reset.css": "./dist/reset.css",
    "./fonts.css": "./dist/fonts.css",
    "./*.css": "./dist/*.css",
    "./assets/*": "./dist/assets/*"
  },
  "dependencies": {
    "@hawiyah/tokens": "workspace:*"
  },
  "keywords": [
    "hawiyah",
    "dga",
    "sdga",
    "platforms-code",
    "saudi-design-system",
    "arabic",
    "rtl",
    "ui-components",
    "styles"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohamedEmbarak/hawiyah.git",
    "directory": "packages/styles"
  },
  "homepage": "https://mohamedembarak.github.io/hawiyah/",
  "bugs": {
    "url": "https://github.com/MohamedEmbarak/hawiyah/issues"
  },
  "author": {
    "name": "Development Team, National Platforms Sector — National Information Center"
  },
  "contributors": [
    {
      "name": "Mohamed Embarak",
      "url": "https://github.com/MohamedEmbarak"
    }
  ]
}
