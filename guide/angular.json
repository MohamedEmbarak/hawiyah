{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "guide": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "guide",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "server": "src/main.server.ts",
            "outputMode": "static",
            "index": "src/generated/index.html",
            "tsConfig": "tsconfig.app.json",
            "outputPath": {
              "base": "dist",
              "browser": "browser",
              "server": "server"
            },
            "styles": ["src/styles.css", { "input": "src/guide.css", "bundleName": "guide" }],
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              {
                "glob": "{hawiyah-wordmark.svg,hawiyah-wordmark-reverse.svg,hawiyah-wordmark-mono.svg,hawiyah-wordmark-white.svg,hawiyah-loader.gif,hawiyah-loader-white.gif,favicon.svg}",
                "input": "node_modules/@hawiyah/styles/dist/assets",
                "output": "brand"
              }
            ],
            "loader": {
              ".frame.js": "text"
            },
            "define": {
              "HAWIYAH_PREVIEW_COMMIT": "''"
            }
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              },
              "sourceMap": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumError": "1000kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumError": "8kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "guide:build:production"
            },
            "development": {
              "buildTarget": "guide:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "runner": "vitest",
            "buildTarget": "::development"
          }
        }
      }
    }
  }
}
