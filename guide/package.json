{
  "name": "hawiyah-guide",
  "version": "0.0.0",
  "private": true,
  "description": "Public guide of Hawiyah, prerendered as static files and built only from the published @hawiyah packages.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "check:registry": "node scripts/registry-check/cli.mjs",
    "check:registry:negative": "node scripts/registry-check/negative.mjs",
    "lint": "node scripts/lint/cli.mjs",
    "lint:negative": "node scripts/lint/negative.mjs",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "build": "node scripts/build.mjs",
    "build:dev-check": "HAWIYAH_BASE_PATH=${HAWIYAH_BASE_PATH:-/hawiyah/} node scripts/build.mjs --configuration development && playwright test --project=dev",
    "scan:log": "node scripts/log-scan/cli.mjs",
    "test:unit": "node scripts/build.mjs --generate-only && ng test --no-watch",
    "test:e2e": "playwright test --project=prod",
    "serve": "node scripts/serve.mjs",
    "start": "node scripts/build.mjs --generate-only && ng serve",
    "content:hash": "node scripts/content/hash.mjs",
    "preview:local": "node scripts/preview/build-preview.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/ssr": "22.2.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-vue": "0.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@hawiyah/angular": "0.3.0",
    "@hawiyah/core": "0.3.0",
    "@hawiyah/react": "0.3.0",
    "@hawiyah/styles": "0.3.0",
    "@hawiyah/tokens": "0.3.0",
    "@hawiyah/vanilla": "0.3.0",
    "@hawiyah/vue": "0.3.0",
    "@lezer/css": "1.3.9",
    "@lezer/highlight": "1.2.5",
    "@lezer/html": "1.3.13",
    "@lezer/javascript": "1.5.6",
    "@vue/compiler-sfc": "3.5.44",
    "es-module-lexer": "2.3.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "sucrase": "3.35.1",
    "tslib": "2.8.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.0.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "github-slugger": "2.0.0",
    "jsdom": "27.4.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "parse5": "8.0.1",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "postcss": "8.5.32",
    "postcss-selector-parser": "7.1.7",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1"
  }
}
